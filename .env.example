# Netlify Functions environment (set in the Netlify dashboard; never VITE_/dart-define secrets)
# ANTHROPIC_API_KEY=        # chess-commentary + health (required)
# OPENAI_API_KEY=           # optional provider
# GOOGLE_API_KEY=           # optional provider
# APP_SECRET_TOKEN=         # optional X-App-Token check; baked into the public web build, NOT a secret
# HEALTH_DEEP_SECRET=       # required header X-Health-Secret for /api/health?deep=1 (paid round-trip)
# AI_PER_IP_DAILY=100       # optional override: commentary calls per IP per UTC day
# AI_GLOBAL_DAILY=1500      # optional override: commentary calls per UTC day, all users
